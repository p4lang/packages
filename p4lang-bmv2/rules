#!/usr/bin/make -f
# -*- makefile -*-
# https://www.debian.org/doc/debian-policy/ch-source.html#s-debianrules
# https://manpages.debian.org/stretch/debhelper/debhelper.7.en.html

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

export DEB_CFLAGS_MAINT_APPEND=-g -O3
export DEB_CXXFLAGS_MAINT_APPEND=-g -O3

version := $(shell dpkg-parsechangelog -S Version | sed -rne 's,([^-\+]+)+(\+dfsg)*.*,\1,p'i)
source := $(shell dpkg-parsechangelog -S Source)
upstreampck := $(source)_$(version).orig.tar.gz

pkgdir := $(CURDIR)/debian/p4lang-bmv2

%:
	dh $@ --with python3 --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DWITH_PDFIXED=ON \
		-DWITH_THRIFT=ON \
		-DWITH_NANOMSG=ON \
		-DWITH_PI=ON \
		-DENABLE_PACKET_TRACE=ON

override_dh_auto_install:
	dh_auto_install --destdir=$(pkgdir)
	# Leave out the demo router, test data, helper scripts and upstream-named
	# docs that upstream's install also ships.
	rm -r \
		$(pkgdir)/usr/bin/simple_router \
		$(pkgdir)/usr/share/simple_router \
		$(pkgdir)/usr/share/behavioral-model \
		$(pkgdir)/usr/share/doc/behavioral-model
	# Thrift's gen-py root marker; site-packages itself is not a package.
	rm $(pkgdir)/usr/lib/python3*/site-packages/__init__.py
