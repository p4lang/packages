Description: Link absl_strings and absl_synchronization into simple_switch_grpc when absl is found
 Ubuntu 26.04 needs them linked explicitly.
Author: Andy Fingerhut <andy_fingerhut@alum.wustl.edu>
Origin: upstream, https://github.com/p4lang/behavioral-model/commit/c8d8a3f054ba108d668d2eb986188dbf38b9e938
Bug: https://github.com/p4lang/behavioral-model/pull/1463
Applied-Upstream: c8d8a3f054ba108d668d2eb986188dbf38b9e938
--- a/targets/simple_switch_grpc/CMakeLists.txt
+++ b/targets/simple_switch_grpc/CMakeLists.txt
@@ -24,12 +24,26 @@
   ${PROTO_GENERATED_FILES}
 )

+find_package(absl CONFIG QUIET)
+if(absl_FOUND)
+  message(STATUS "absl found.  Linking extra libraries for simple_switch_grpc.")
+  set(EXTRA_LINK_LIBRARIES
+      absl_strings
+      absl_synchronization
+  )
+else()
+  message(STATUS "absl not found.  No extra libraries being linked for simple_switch_grpc.")
+  set(EXTRA_LINK_LIBRARIES
+  )
+endif()
+
 target_link_libraries(simpleswitchgrpc
   simpleswitch
   bmpi
   bm_grpc_dataplane
   ${PROTOBUF_LIBRARIES}
   ${GRPC_LIBRARIES}
+  ${EXTRA_LINK_LIBRARIES}
 )

 target_include_directories(simpleswitchgrpc PRIVATE
