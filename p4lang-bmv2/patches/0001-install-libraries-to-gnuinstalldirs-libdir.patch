Description: Install libraries to GNUInstallDirs' libdir
 A hard-coded lib/ ignores the multiarch libdir that debhelper passes in.
Author: Bryan Richter <b@chreekat.net>
Forwarded: no
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -19,6 +19,7 @@
 include(CheckIncludeFiles)
 include(CheckIncludeFileCXX)
 include(GenerateThrift)
+include(GNUInstallDirs)
 
 # Extract version from VERSION file
 file(READ "${CMAKE_CURRENT_SOURCE_DIR}/VERSION" BM_VERSION)
--- a/PI/CMakeLists.txt
+++ b/PI/CMakeLists.txt
@@ -40,8 +40,8 @@
 endif()
 
 install(TARGETS bmpi
-  LIBRARY DESTINATION lib
-  ARCHIVE DESTINATION lib
+  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
 )
 
 install(FILES bm/PI/pi.h
