#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Bryan Richter
#
# SPDX-License-Identifier: Apache-2.0

#
# Upload a source package directory to an OBS project/package.
#
# Usage: upload-src-pkg <project> <package> <srcdir>
#
# The srcdir must contain exactly one .dsc; it and the files it references
# are what get uploaded. Credentials come from osc's normal config (or the
# OSC_USERNAME/OSC_PASSWORD env vars osc reads natively).

set -euo pipefail
die() { echo "error: $*" >&2; exit 1; }

script_dir=$(dirname "$(readlink -f "$0")")

usage="Usage: upload-src-pkg <project> <package> <srcdir>"
project="${1:?$usage}"
package="${2:?$usage}"
srcdir="${3:?$usage}"

[[ -d "$srcdir" ]] || die "no such dir: $srcdir"
shopt -s nullglob; dscs=( "$srcdir"/*.dsc ); shopt -u nullglob
(( ${#dscs[@]} == 1 )) || die "expected exactly one .dsc in $srcdir, found ${#dscs[@]}"
dsc="${dscs[0]}"

# A published version only ever moves forward; a re-release must bump the
# Debian revision instead.
version=$(awk '/^Version:/ { print $2; exit }' "$dsc")
[[ -n "$version" ]] || die "$dsc has no Version: field"
if published=$("$script_dir/obs-published-version" "$project" "$package"); then
    if ! dpkg --compare-versions "$version" gt "$published"; then
        echo "$package $version is not newer than $published on $project; nothing to upload."
        echo "(a re-release needs a new Debian revision: just changelog-add)"
        exit 0
    fi
else
    echo "could not read the published version; assuming a first upload." >&2
fi

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

echo "Checking out ${project}/${package}..."
(cd "$workdir" && osc checkout "$project" "$package")
pkg_dir="$workdir/$project/$package"
[[ -d "$pkg_dir" ]] || die "checkout failed: $pkg_dir does not exist"

# Replace the old source files (keeping _meta and other OBS internals) with
# the .dsc and everything it references.
find "$pkg_dir" -maxdepth 1 -type f ! -name '_*' -delete
dcmd cp "$dsc" "$pkg_dir/"

(
    cd "$pkg_dir"
    osc addremove
    osc commit -m "$(basename "$dsc" .dsc)"
)

echo "Done. Uploaded to ${project}/${package}."
