#!/usr/bin/make -f
# -*- makefile -*-
# https://www.debian.org/doc/debian-policy/ch-source.html#s-debianrules
# https://manpages.debian.org/stretch/debhelper/debhelper.7.en.html

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

version := $(shell dpkg-parsechangelog -S Version | sed -rne 's,([^-\+]+)+(\+dfsg)*.*,\1,p'i)
source := $(shell dpkg-parsechangelog -S Source)
upstreampck := $(source)_$(version).orig.tar.gz

%:
	dh $@ --with python3

clean:
	dh_testdir
	dh_auto_clean || true
	dh_clean

override_dh_auto_configure:
	# Compiler caching is the build environment's job (OBS's useccache).
	dh_auto_configure --builddirectory=build/ -- \
		-DENABLE_CCACHE=OFF \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON \
		-DFETCHCONTENT_SOURCE_DIR_PROTOBUF=$(CURDIR)/protobuf \
		-DFETCHCONTENT_SOURCE_DIR_ABSEIL=$(CURDIR)/abseil \
		-DFETCHCONTENT_SOURCE_DIR_P4RUNTIME=$(CURDIR)/p4runtime \
		-DFETCHCONTENT_SOURCE_DIR_INJA=$(CURDIR)/inja \
		-DP4C_USE_PREINSTALLED_BDWGC=ON \
		-DUSE_PREINSTALLED_Z3=ON \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DENABLE_BMV2=ON \
		-DENABLE_EBPF=ON \
		-DENABLE_UBPF=ON \
		-DENABLE_DPDK=ON \
		-DENABLE_P4C_GRAPHS=ON \
		-DENABLE_P4TEST=ON \
		-DENABLE_DOCS=OFF \
		-DENABLE_GC=ON \
		-DENABLE_GTESTS=OFF \
		-DENABLE_PROTOBUF_STATIC=ON \
		-DENABLE_MULTITHREAD=OFF \
		-DENABLE_TEST_TOOLS=ON \
		-DENABLE_GMP=ON


override_dh_auto_install:
	# The build environment's compiler cache hit rate, when it has one.
	-ccache --zero-stats
	dh_auto_install --builddirectory=build/ -- DESTDIR=$(CURDIR)/debian/p4lang-p4c install
	-ccache --show-stats --verbose
