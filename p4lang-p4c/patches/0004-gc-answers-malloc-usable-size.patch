Description: Answer allocation-size queries from the GC heap, allowing Z3 4.12+
 Z3 4.12 and newer call malloc_usable_size, which otherwise reaches glibc's
 allocator with pointers into the GC heap and crashes. Backport of
 p4lang/p4c#5856 without its documentation and test changes.
Author: Bryan Richter <b@chreekat.net>
Origin: backport, https://github.com/p4lang/p4c/pull/5856
Forwarded: https://github.com/p4lang/p4c/pull/5856
--- a/cmake/FindZ3.cmake
+++ b/cmake/FindZ3.cmake
@@ -30,13 +30,7 @@
 
 include(FindPackageHandleStandardArgs)
 
-find_package_handle_standard_args(
-  Z3 DEFAULT_MSG
-  Z3_INCLUDE_DIR
-  Z3_LIBRARY
-)
-
-if(Z3_FOUND)
+if(Z3_INCLUDE_DIR)
   message(STATUS "Found Z3 includes at ${Z3_INCLUDE_DIR}.")
   file(READ "${Z3_INCLUDE_DIR}/z3_version.h" Z3_VERSION_FILE)
 
@@ -56,6 +50,14 @@
   set(Z3_VERSION_STRING "${Z3_VERSION_MAJOR}.${Z3_VERSION_MINOR}.${Z3_VERSION_PATCH}.${Z3_VERSION_TWEAK}")
 endif()
 
+# Read the version before checking the package so find_package can enforce
+# the minimum version requested by its caller.
+find_package_handle_standard_args(
+  Z3
+  REQUIRED_VARS Z3_INCLUDE_DIR Z3_LIBRARY
+  VERSION_VAR Z3_VERSION_STRING
+)
+
 message(STATUS "Z3 version: ${Z3_VERSION_STRING}")
 message(STATUS "Z3 library: ${Z3_LIBRARY}")
 message(STATUS "Z3 include dir: ${Z3_INCLUDE_DIR}")
