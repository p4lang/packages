Description: Build test_rpc_target only with the internal RPC target
 It links targets/rpc/libpi_rpc.la, which configure builds only with
 --with-internal-rpc, so make check failed in the default configuration.
Author: Bryan Richter <b@chreekat.net>
Forwarded: no
diff --git a/tests/Makefile.am b/tests/Makefile.am
index 9acdc1c..d01e6cc 100644
--- a/tests/Makefile.am
+++ b/tests/Makefile.am
@@ -24,8 +24,7 @@ test_bmv2_json_reader \
 test_read_file \
 test_getnetv \
 test_p4info \
-test_frontends_generic \
-test_rpc_target
+test_frontends_generic
 
 common_source = main.c utils.c utils.h
 
@@ -86,9 +85,13 @@ test_read_file \
 test_getnetv \
 test_p4info \
 test_frontends_generic \
-test_rpc_target \
 test_all
 
+if WITH_INTERNAL_RPC
+TESTS += test_rpc_target
+check_PROGRAMS += test_rpc_target
+endif
+
 EXTRA_DIST = \
 testdata/simple_router.json \
 testdata/valid.json \
